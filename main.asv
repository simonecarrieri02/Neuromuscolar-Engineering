clear
close all
clc

%% ---------- Data Loading --------------
% The EMG data were acquired using the MomtaSens device with 6 channels
% of surface EMG (sEMG). The dataset is stored in a .mat file where:
%   - n represents the number of channels
%   - m represents the number of samples per channel
%
% The sampling frequency of the acquisition system is 2000 Hz.

load("Acquisizione_2.mat");

fs = 2000; %sampling frequencey
[numChannels, numSamples] = size(data);
t = (0:numSamples-1) / fs; 

nChannels = 6;

%---------------- Data plotting -------------------
figure('Name', 'Visualization of 6 RAW CHANNELS EMG', 'Color', 'w');

for i = 1:numChannels
    subplot(numChannels, 1, i); 
    plot(t, data(i, :), 'LineWidth', 0.8);
    
    grid on;
    ylabel(['Ch ' num2str(i)]);
    xlim([t(1) t(end)]); 
    ylim([min(data(i,:)) max(data(i,:))])
    
    if i < numChannels
        set(gca, 'XTickLabel', []);
    else
        xlabel('Tempo [s]');
    end
end

sgtitle('Raw Data MotemaSens');

%% ---------- Data Filtering --------------
% EMG signals are characterized by most of their spectral energy
% in the range 20–450 Hz. Frequencies below 20 Hz are typically
% associated with motion artifacts, while frequencies above 450 Hz
% are dominated by measurement noise.

% A 5th-order Butterworth filter is used due to its flat passband
% response, ensuring minimal distortion of the EMG amplitude envelope.

f_nyq = fs / 2; %Nyquist frequency

low_cut = 20;%low cut frequency
high_cut = 450; %high cut frequency

Wp = [low_cut high_cut] / f_nyq; %passband
Ws = [10 500] / f_nyq; %stopband

[b, a] = butter(5, Wp, 'bandpass'); 
filteredData = zeros(size(data)); 

for i = 1:6
    filteredData(i, :) = filtfilt(b, a, data(i, :)); 
end

for i = 1:numChannels
    filteredData(i, 1:0.4*fs) = filteredData(i, end-0.4*fs+1 : end) ; %first 0.1s of the signals equal to baseline noise
end
filteredData = circshift(filteredData, 0.5*fs, 2);

%---------------- Data plotting -------------------
figure('Name', 'Visualization of 6 FILTERED CHANNELS EMG', 'Color', 'w');

for i = 1:numChannels
    subplot(numChannels, 1, i); 
    plot(t, filteredData(i, :), 'LineWidth', 0.8);
    
    grid on;
    ylabel(['Ch ' num2str(i)]);
    xlim([t(1) t(end)]); 
    ylim([min(filteredData(i,:)) max(filteredData(i,:))])
    
    if i < numChannels
        set(gca, 'XTickLabel', []);
    else
        xlabel('Tempo [s]');
    end
end

sgtitle('Filtered Data MotemaSens');


%% ---------- Envelope extraction --------------

% Machine learning techniques are applied to the EMG signal to classify
% hand opening and closing movements.
%
% The analysis focuses on the amplitude envelope of the signal, which
% contains the most relevant information for distinguishing different
% muscle activation patterns.
%
% The envelope is computed by full-wave rectification followed by a
% low-pass filter at 10 Hz, providing a smooth estimate of the
% underlying muscle activation dynamics.

cutoff_env = 20;                   
Wp_env = cutoff_env / f_nyq;         

[b_env, a_env] = butter(5, Wp_env, 'low');


for i = 1:numChannels
    rectifiedData = abs(filteredData); % rectification
    envelopeData(i, :) = filtfilt(b_env, a_env, rectifiedData(i, :)); % apply filter to get envelope
end

% Data plotting ----------
figure('Name', 'Visualization of 6 ENVELOPE CHANNELS EMG', 'Color', 'w');


for i = 1:numChannels
    subplot(numChannels, 1, i); 
    plot(t, envelopeData(i, :), 'LineWidth', 0.8);
    
    grid on;
    ylabel(['Ch ' num2str(i)]);
    xlim([t(1) t(end)]);
    ylim([min(envelopeData(i,:)) max(envelopeData(i,:))])
    
    if i < numChannels
        set(gca, 'XTickLabel', []);
    else
        xlabel('Tempo [s]');
    end
end

sgtitle('Envelope Data MomtaSens');



%% ---------- Identification of the activations --------------
% To identify the activation instants corresponding to hand opening and 
% closing movements, the findpeaks function is applied to the most 
% informative EMG channel (channel 4 in this case). Peak detection is 
% performed by setting appropriate values for MinPeakHeight and 
% MinPeakDistance to avoid detecting noise or multiple peaks within the 
% same contraction.
%
% Once the peaks are identified, fixed-length windows of 3 seconds are 
% extracted around each detected peak. Each window starts 0.6 seconds 
% before the peak and ends 2.4 seconds after the peak, ensuring that the 
% full contraction dynamics are captured.

refCh = 4;
signal   = filteredData(refCh, :);
envelope = envelopeData(refCh, :);

[pks, t_pks] = findpeaks(envelope, fs, MinPeakDistance=1.8, MinPeakHeight=0.09);

starts = round(t_pks * fs); %samples

preSamp  = round(0.6 * fs);           
postSamp = round(2.4 * fs);           
winSamp  = preSamp + postSamp; 

%---------------- Data plotting -------------------
figure('Name', 'Verifica Finestre 3s (Linear Envelope)');
plot(t, signal, 'Color', [0.6 0.6 0.6], 'LineWidth', 0.5); hold on;
plot(t, envelope, 'r', 'LineWidth', 1.2);
plot(t_pks, pks, 'ko', 'MarkerSize', 6, 'LineStyle', 'none');

for k = 1:length(t_pks)
    tStart_detect = t_pks(k);         
    winStart = tStart_detect - (preSamp/fs);
    winEnd   = tStart_detect + (postSamp/fs);
    patch([winStart winEnd winEnd winStart], [-2 -2 2 2], ...
          'yellow', 'FaceAlpha', 0.3, 'EdgeColor', 'none');
    text(tStart_detect, 1.8, num2str(k), 'FontSize', 7, 'Color', 'k');
end
xlabel('Time [s]'); ylabel('mV');
title(['Peaks identified: ' num2str(length(t_pks)) ' - Envelope Low-pass 10Hz']);
legend('Singal','Envelope', 'Peaks'); hold off;


idxOpening = [1, 3, 5:12];    % 1 (maximum opening); 3(maximum opening); 5:12(sub-maximal opening)
idxClosing = [2, 4, 13:20];   % 2 (maximum closing); 4(maximum closing); 13:20(sub-maximal closing)

nO = length(idxOpening);
nC = length(idxClosing);
segO = zeros(winSamp, nChannels, nO); %winSamp x channels x nO
segC = zeros(winSamp, nChannels, nC); %winSamp x channels x nC

% Estrazione con rispetto del pre-trigger (s_start)
for k = 1:nO
    s_detect = starts(idxOpening(k));
    s_start  = s_detect - preSamp; 
    if s_start < 1, s_start = 1; end
    segO(:,:,k) = filteredData(:, s_start : s_start + winSamp - 1).';
end

for k = 1:nC
    s_detect = starts(idxClosing(k));
    s_start  = s_detect - preSamp; 
    if s_start < 1, s_start = 1; end
    segC(:,:,k) = filteredData(:, s_start : s_start + winSamp - 1).';
end

%Permutating: winSamp x channels x n -> winSamp x n x channels
%Reshaping: winSamp x n x channels -> (winSamp*n) x channels
allOpening = reshape(permute(segO, [1,3,2]), [], nChannels);
allClosing = reshape(permute(segC, [1,3,2]), [], nChannels);
allOpeClo = [allOpening; allClosing];

fprintf('Final matrix complete: %d x %d\n', size(allOpeClo,1), size(allOpeClo,2));

%---------------- Data plotting Filtered Data -------------------
[m_new, n_new] = size(allOpeClo);
t_final = (0:m_new-1) / fs; %new time axis for allOpeClo

figure('Name', 'Visualization of 6 CHANNELS', 'Color', 'w');

for i = 1:n_new
    subplot(n_new, 1, i);
    
    plot(t_final, allOpeClo(:, i), 'LineWidth', 0.8, 'Color', [0 0.4470 0.7410]);
    
    grid on;
    ylabel(['Ch ' num2str(i) ' [mV]']);
    xlim([t_final(1) t_final(end)]);
    ylim([-2 2]);
    
    %Line mark to separate opening from closing
    fine_aperture_sec = size(allOpening, 1) / fs;
    xline(fine_aperture_sec, 'r', 'LineWidth', 1.5, 'Alpha', 0.7);
    
    if i < n_new
        set(gca, 'XTickLabel', []);
    else
        xlabel('Time[s]');
    end
end

sgtitle('Filtered Data MotemaSens: 9 Opening then 9 Closing');

subplot(n_new, 1, 1);
legend('Signal EMG', 'Separation O/C', 'Location', 'northeast');



%---------------- Data plotting Envelope Data -------------------
rectifiedFinal = abs(allOpeClo); 
envelopeFinal = zeros(size(rectifiedFinal));

for i = 1:size(allOpeClo, 2) 
    envelopeFinal(:, i) = filtfilt(b_env, a_env, rectifiedFinal(:, i)); 
end

t_final = (0:size(envelopeFinal, 1)-1) / fs;

figure('Name', 'Visualization of 6 ENVELOPE CHANNELS (Reorganized)', 'Color', 'w');

for i = 1:size(envelopeFinal, 2)
    subplot(size(envelopeFinal, 2), 1, i); 
    plot(t_final, envelopeFinal(:, i), 'LineWidth', 1, 'Color', [0.8500 0.3250 0.0980]);
    
    grid on;
    ylabel(['Ch ' num2str(i) ' [mV]']);
    xlim([t_final(1) t_final(end)]); 
    ylim([-0.1 0.7]); 
    
    fine_aperture_sec = size(allOpening, 1) / fs;
    xline(fine_aperture_sec, 'r', 'LineWidth', 1.5, 'Label', 'A | C');
    
    if i < size(envelopeFinal, 2)
        set(gca, 'XTickLabel', []);
    else
        xlabel('Tempo virtuale (Aperture + Chiusure) [s]');
    end
end

sgtitle('Envelope Data MotemaSens - Reorganized (Apertures then Closures)');


%% -----------------------------------------------------------------------
%  Feature Extraction & SVM Classification
%  -----------------------------------------------------------------------
%  Each contraction segment is described by 6 time-domain features per
%  channel (MAV, RMS, VAR, WL, ZC, SSC), yielding a feature vector of
%  length nChannels * nFeature for each observation.
%  Labels: 1 = Opening,  -1 = Closing
%  -----------------------------------------------------------------------

nContractions = nO + nC;
nFeature = 6;

% --- Dataset assembly ---------------------------------------------------
X = zeros(nContractions, nChannels * nFeature);  % [nContractions × 36]
y = [ones(nO, 1); -ones(nC, 1)];                 % class labels

for k = 1:nO
    X(k,:) = extractFeatures(segO(:,:,k));
end
for k = 1:nC
    X(nO+k,:) = extractFeatures(segC(:,:,k));
end

% --- Train / test split (70 / 30, stratified) ---
cv = cvpartition(y, 'HoldOut', 0.3);
Xtrain = X(training(cv),:);   ytrain = y(training(cv));
Xtest  = X(test(cv),:);   ytest  = y(test(cv));

% --- SVM training ---
SVMModel = fitcsvm(Xtrain, ytrain,'KernelFunction', 'linear', 'Standardize', true);

% --- Predictions ---
ypredTrain = predict(SVMModel, Xtrain);
ypredTest  = predict(SVMModel, Xtest);

% --- Evaluation ---
accTrain = mean(ypredTrain == ytrain) * 100;
accTest  = mean(ypredTest  == ytest)  * 100;
fprintf('Training accuracy : %.2f %%\n', accTrain);
fprintf('Test accuracy : %.2f %%\n', accTest);

figure;
confusionchart(ytrain, ypredTrain);
title(sprintf('Confusion Matrix – Training Set  (acc = %.1f %%)', accTrain));

figure;
confusionchart(ytest, ypredTest);
title(sprintf('Confusion Matrix – Test Set  (acc = %.1f %%)', accTest));


% --- LDA training ---
LDAModel = fitcdiscr(Xtrain, ytrain);

% --- Predictions ---
ypredLDATrain = predict(LDAModel, Xtrain);
ypredLDATest  = predict(LDAModel, Xtest);

% --- Evaluation ---
accLDATrain = mean(ypredLDATrain == ytrain) * 100;
accLDATest  = mean(ypredLDATest  == ytest)  * 100;
fprintf('Training accuracy LDA: %.2f %%\n', accLDATrain);
fprintf('Test accuracy LDA: %.2f %%\n', accLDATest);

figure;
confusionchart(ytrain, ypredLDATrain);
title(sprintf('Confusion Matrix LDA – Training Set  (acc = %.1f %%)', accLDATrain));

figure;
confusionchart(ytest, ypredLDATest);
title(sprintf('Confusion Matrix LDA – Test Set  (acc = %.1f %%)', accLDATest));


%% -----------------------------------------------------------------------
%  Cosine Similarity Classifier
% -----------------------------------------------------------------------
%  Each contraction segment is characterised by its Average Rectified
%  Value (ARV) computed over overlapping windows. A prototype vector is
%  built from the maximal contraction (segment 1) for each class, and
%  sub-maximal contractions (segments 3:end) are classified by cosine
%  similarity to those prototypes.
%  Labels: 1 = Opening,  -1 = Closing
% -----------------------------------------------------------------------

% --- Prototype computation ---

% Segment 1 is the maximal contraction for each class
maxSegO = segO(:,:,1);
maxSegC = segC(:,:,1);

% Window parameters: 250 ms, 50% overlap
win_len = round(0.250 * fs);
step    = round(win_len * 0.50);

% Number of valid windows per maximal contraction
n_win_O = floor((size(maxSegO,1) - win_len) / step) + 1;
n_win_C = floor((size(maxSegC,1) - win_len) / step) + 1;

% Compute per-window ARV for the maximal contractions
ARV_max_O = zeros(n_win_O, nChannels);
ARV_max_C = zeros(n_win_C, nChannels);

for j = 1:n_win_O
    idx = (j-1)*step + (1:win_len);
    ARV_max_O(j,:) = mean(abs(maxSegO(idx,:)), 1);
end

for j = 1:n_win_C
    idx = (j-1)*step + (1:win_len);
    ARV_max_C(j,:) = mean(abs(maxSegC(idx,:)), 1);
end

% Prototype: average ARV across windows → column vector (nChannels × 1)
prot_ARV_O = mean(ARV_max_O, 1)';
prot_ARV_C = mean(ARV_max_C, 1)';

% --- ARV Extraction ---

% Segments 3:end are treated as sub-maximal contractions
submaxSegO = segO(:,:,3:end);
submaxSegC = segC(:,:,3:end);
nSubMax = size(submaxSegO, 3);   

% Per-window ARV for every channel and sub-maximal repetition
ARV_sub_O = zeros(n_win_O, nChannels, nSubMax);
ARV_sub_C = zeros(n_win_C, nChannels, nSubMax);

for n = 1:nSubMax
    for j = 1:n_win_O
        idx = (j-1)*step + (1:win_len);
        ARV_sub_O(j,:,n) = mean(abs(submaxSegO(idx,:,n)), 1);
    end
    for j = 1:n_win_C
        idx = (j-1)*step + (1:win_len);
        ARV_sub_C(j,:,n) = mean(abs(submaxSegC(idx,:,n)), 1);
    end
end

% Average across windows → (nChannels × nSubMax), then transpose
% Result: (nSubMax × nChannels) — one feature vector per repetition
ARV_sub_O = squeeze(mean(ARV_sub_O, 1))';   % nSubMax × nChannels
ARV_sub_C = squeeze(mean(ARV_sub_C, 1))';

% Full feature matrix and ground-truth labels
ARV = [ARV_sub_O; ARV_sub_C];                    % (2·nSubMax) × nChannels
trueLabels = [ones(nSubMax,1); -1*ones(nSubMax,1)];       % 1 = Open, -1 = Close

% --- Evaluation ---

pred = cosineClassifier(ARV, prot_ARV_O, prot_ARV_C);

% Confusion matrix
C = confusionmat(trueLabels, pred);

figure;
confusionchart(C, {'Open','Close'}, ...
    'Title',         'Confusion Matrix – Cosine Classifier', ...
    'RowSummary',    'row-normalized', ...
    'ColumnSummary', 'column-normalized');

% Metrics
accuracy = sum(diag(C)) / sum(C(:)) * 100;

fprintf('\n--- Classification results ---\n');
fprintf('Accuracy: %.1f%%\n', accuracy);